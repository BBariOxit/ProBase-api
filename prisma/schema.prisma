// This is your Prisma schema file
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────

enum Role {
  ADMIN
  LECTURER
  STUDENT
}

enum TopicProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum TopicStatus {
  PENDING
  APPROVED
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum RegistrationGroupStatus {
  FORMING
  SUBMITTED
  APPROVED
  REJECTED
}

enum GroupMemberStatus {
  INVITED
  ACCEPTED
  DECLINED
}

enum SubmissionType {
  MIDTERM
  FINAL
  SOURCE_CODE
}

enum CouncilMemberRole {
  PRESIDENT
  SECRETARY
  REVIEWER
  MEMBER
}
