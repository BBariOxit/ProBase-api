# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000

# Number of reverse proxies in front of the API, 0 or unset when there are none.
# Rate limiting counts by req.ip, and Express only reads X-Forwarded-For when it
# is told how many hops to trust. Leave at 0 for local and for a directly exposed
# process: setting it without a proxy that overwrites the header lets any caller
# forge an address and bypass every limit. Behind one nginx or platform router,
# set 1.
TRUST_PROXY_HOPS=0

# Database (PostgreSQL)
DATABASE_URL="postgresql://probase:probase123@localhost:5432/probase?schema=public"

# JWT
JWT_SECRET=your-super-secret-key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=probase-storage

# Brevo (Mail)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@probase.dev
BREVO_SENDER_NAME=ProBase

# Seed accounts (npm run prisma:seed) — dev fixtures, not real credentials
SEED_ADMIN_EMAIL=admin@probase.dev
SEED_ADMIN_PASSWORD=Admin@12345

# Student email is <student code>@dlu.edu.vn; cohort is derived from the code.
# This one starts with mustChangePassword=true (drives the forced-change screen).
SEED_STUDENT_CODE=2212345
SEED_STUDENT_EMAIL=2212345@dlu.edu.vn
SEED_STUDENT_PASSWORD=Student@123

# Two lecturers share this password: gv001@probase.dev and gv002@probase.dev
SEED_LECTURER_PASSWORD=Lecturer@123
