# App
NODE_ENV=development
PORT=3001

# Database (PostgreSQL)
DATABASE_URL="postgresql://probase:probase123@localhost:5432/probase?schema=public"

# JWT
JWT_SECRET=your-super-secret-key
JWT_EXPIRES_IN=7d

# AWS S3
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=probase-storage

# Brevo (Mail)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=noreply@probase.dev
BREVO_SENDER_NAME=ProBase
